  "description": "Offline Compton telescope demonstrations: event-cone rotation, photon reconstruction and Compton Data Space.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/run-validation.mjs",
    "test:psi": "node tests/psi-geometry.mjs",
